# Copy to.env and replace both values before docker compose up --build.
POSTGRES_PASSWORD=replace-with-local-database-password
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HEADERS=0
SECURE_COOKIES=0
# For public HTTPS, see docs/GAME_EDITING.md. Keep localhost and 127.0.0.1
# in ALLOWED_HOSTS for the container health check; append the real domain.
